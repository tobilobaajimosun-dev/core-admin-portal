# Auth for the private Hugeicons registry. The token comes from the NPM_TOKEN
# env var (never committed) — set it locally in your shell and as a CI/Vercel
# secret. Mirrors the scope mapping in the developer ~/.npmrc.
@hugeicons-pro:registry=https://npm.hugeicons.com/
//npm.hugeicons.com/:_authToken=${NPM_TOKEN}
