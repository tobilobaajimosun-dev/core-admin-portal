{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "baseUrl": "./",
    "types": [],
    "paths": {
      "@core/*":    ["src/app/core/*"],
      "@pages/*":   ["src/app/pages/*"],
      "@shared/*":  ["src/app/shared/*"],
      "@ui/*":      ["src/app/ui/*"],
      "@pcsl-ui/*": ["./pcsl-ui/*"],
      "@env/*":     ["src/environments/*"]
    }
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "pcsl-ui/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "pcsl-ui/**/*.spec.ts",
    "pcsl-ui/pipes/product-color.pipe.ts"
  ]
}